# Copy this file to .env and fill in your own values
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/ecommerce_db
SECRET_KEY=replace-with-a-long-random-string-32-chars-min
JWT_SECRET_KEY=replace-with-another-long-random-string-32

# Email for "Forgot password" codes. console = print code in the server terminal.
MAIL_MODE=console
# For real email with Gmail: MAIL_MODE=smtp, and an App Password (not your normal password)
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-16-char-app-password
# MAIL_FROM=Anime World Shop <you@gmail.com>

# KHQR payments: a Bakong Open API token (expires about every 90 days, renew it at
# https://api-bakong.nbc.gov.kh) and the Bakong account that receives the money, e.g. yourname@aclb
BAKONG_TOKEN=
BAKONG_ACCOUNT_ID=
