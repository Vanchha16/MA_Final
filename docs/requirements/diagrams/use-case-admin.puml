@startuml use-case-admin
' Anime World Shop - the shop team's tools (admin app tabs and the web admin). Admin = owner, a kind of Staff
!pragma layout smetana
!include style.iuml
left to right direction
title Anime World Shop - Admin Use Cases

actor Staff
actor Admin
actor Customer
Admin -up-|> Staff

rectangle "Anime World Shop - admin app and web panel" {
  package "Dashboard" {
    usecase "View sales and\n7-day revenue" as A_Stats
    usecase "Follow live activity" as A_Feed
  }
  package "Orders" {
    usecase "Search and filter orders" as A_Orders
    usecase "View order details" as A_OrderDetail
    usecase "Move order to next step\n(confirm, ship, deliver)" as A_Step
    usecase "Cancel order" as A_Cancel
    usecase "Notify the customer" as A_Notify
  }
  package "Products" {
    usecase "Add / edit product" as A_Product
    usecase "Upload product photos" as A_Photos
    usecase "Update stock" as A_Stock
    usecase "Show / hide in shop" as A_Hide
    usecase "Manage categories" as A_Cats
  }
  package "Customers and messages" {
    usecase "View customers\nand their orders" as A_Customers
    usecase "Block / unblock customer" as A_Block
    usecase "Reply to a message" as A_Reply
  }
  package "Shop team (owner only)" {
    usecase "Manage staff accounts\n(add, role, password)" as A_Staff
    usecase "Disable / enable\nstaff account" as A_Disable
    usecase "Manage promo codes" as A_Coupons
  }
}

Staff --> A_Stats
Staff --> A_Feed
Staff --> A_Orders
Staff --> A_OrderDetail
Staff --> A_Step
Staff --> A_Cancel
A_Step .> A_Notify : <<include>>
Staff --> A_Product
A_Photos .> A_Product : <<extend>>
Staff --> A_Stock
Staff --> A_Hide
Staff --> A_Cats
Staff --> A_Customers
Staff --> A_Reply
Admin --> A_Block
A_Block .> A_Customers : <<extend>>
Admin --> A_Staff
A_Disable .> A_Staff : <<extend>>
Admin --> A_Coupons
A_Notify --> Customer
note right of A_Notify
  Also sent when an order
  is cancelled or a
  message is answered
end note
@enduml
