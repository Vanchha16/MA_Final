@startuml use-case-customer-shopping
' Anime World Shop - everything a signed-in customer can do
!pragma layout smetana
!include style.iuml
left to right direction
title Anime World Shop - Customer: Browse, Cart and Wishlist

actor Customer

rectangle "Anime World Shop - customer app" {
  package "Browse products" {
    usecase "Browse home\n(banners, series, featured)" as C_Home
    usecase "Browse categories" as C_Cats
    usecase "View product list" as C_List
    usecase "Search products" as C_Search
    usecase "Filter and sort\n(category, series, brand,\nprice, in stock)" as C_Filter
    usecase "View product details" as C_Details
  }
  package "Cart and wishlist" {
    usecase "Add to cart" as C_Add
    usecase "Update quantity" as C_Qty
    usecase "Remove from cart" as C_Remove
    usecase "Add to / remove\nfrom wishlist" as C_Wish
    usecase "Move wishlist\nitems to cart" as C_Move
  }
}

Customer --> C_Home
Customer --> C_Cats
Customer --> C_List
Customer --> C_Search
Customer --> C_Details
C_Filter .> C_List : <<extend>>
C_Filter .> C_Search : <<extend>>
Customer --> C_Add
Customer --> C_Qty
Customer --> C_Remove
Customer --> C_Wish
Customer --> C_Move
C_Add .> C_Details : <<extend>>
@enduml
