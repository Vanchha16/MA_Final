// Paste into https://dbdiagram.io to render the ERD

Table users {
  id int [pk, increment]
  full_name varchar(100) [not null]
  email varchar(150) [not null, unique]
  password_hash varchar(255) [not null]
  phone varchar(20)
  avatar_url varchar(255)
  role varchar [not null, default: 'customer', note: 'customer | staff | admin']
  is_active boolean [not null, default: true]
  token_version int [not null, default: 0, note: '+1 signs the account out everywhere']
  last_login_at datetime
  notify_orders boolean [default: true]
  notify_offers boolean [default: true]
  notify_news boolean [default: true]
  created_at datetime
  updated_at datetime
}

Table password_resets {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  code_hash varchar(255) [not null]
  expires_at datetime [not null]
  attempts int [default: 0, note: 'wrong codes entered, max 5']
  used boolean [default: false]
  created_at datetime
}

Table addresses {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  label varchar(50)
  recipient_name varchar(100) [not null]
  phone varchar(20) [not null]
  street varchar(255) [not null]
  city varchar(100) [not null]
  province varchar(100)
  postal_code varchar(20)
  is_default boolean [default: false]
  created_at datetime
}

Table categories {
  id int [pk, increment]
  name varchar(100) [not null]
  slug varchar(120) [not null, unique]
  description text
  image_url varchar(255)
  created_at datetime
}

Table series {
  id int [pk, increment]
  name varchar(100) [not null, note: 'Anime franchise, e.g. One Piece']
  slug varchar(120) [not null, unique]
  image_url varchar(255)
  created_at datetime
}

Table products {
  id int [pk, increment]
  category_id int [not null, ref: > categories.id]
  series_id int [ref: > series.id]
  brand varchar(100)
  name varchar(150) [not null]
  slug varchar(170) [not null, unique]
  description text
  price decimal(10,2) [not null]
  discount_price decimal(10,2)
  stock int [not null, default: 0]
  is_featured boolean [default: false]
  is_active boolean [default: true]
  created_at datetime
  updated_at datetime
}

Table product_images {
  id int [pk, increment]
  product_id int [not null, ref: > products.id]
  image_url varchar(255) [not null]
  is_primary boolean [default: false]
  sort_order int [default: 0]
}

Table cart_items {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  product_id int [not null, ref: > products.id]
  quantity int [not null, default: 1]
  created_at datetime
  indexes { (user_id, product_id) [unique] }
}

Table favorites {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  product_id int [not null, ref: > products.id]
  created_at datetime
  indexes { (user_id, product_id) [unique] }
}

Table orders {
  id int [pk, increment]
  order_number varchar(30) [not null, unique]
  user_id int [not null, ref: > users.id]
  shipping_name varchar(100) [not null]
  shipping_phone varchar(20) [not null]
  shipping_address varchar(500) [not null]
  subtotal decimal(10,2) [not null]
  shipping_fee decimal(10,2) [default: 0]
  discount decimal(10,2) [default: 0]
  coupon_code varchar(30)
  total decimal(10,2) [not null]
  delivery_method varchar [note: 'standard | pickup']
  status varchar [note: 'pending | confirmed | shipped | delivered | cancelled']
  payment_method varchar [note: 'cod | khqr | aba | card']
  payment_status varchar [note: 'unpaid | paid | failed | refund_pending | refunded']
  note varchar(255)
  cancelled_by varchar(10) [note: 'customer | shop | system']
  cancel_reason varchar(200)
  cancelled_at datetime
  refunded_at datetime
  created_at datetime
  updated_at datetime
}

Table payments {
  id int [pk, increment]
  order_id int [not null, ref: > orders.id]
  provider varchar [note: 'mock | bakong | payway']
  qr text [not null]
  md5 char(32) [not null, unique]
  tran_id varchar(20) [unique, note: 'ABA PayWay transaction id']
  deeplink text [note: 'ABA PayWay: opens ABA Mobile']
  amount decimal(10,2) [not null]
  currency char(3) [default: 'USD']
  status varchar [note: 'pending | paid | expired']
  expires_at datetime [not null]
  paid_at datetime
  created_at datetime
}

Table order_items {
  id int [pk, increment]
  order_id int [not null, ref: > orders.id]
  product_id int [ref: > products.id]
  product_name varchar(150) [not null]
  unit_price decimal(10,2) [not null]
  quantity int [not null]
  subtotal decimal(10,2) [not null]
}

Table notifications {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  title varchar(150) [not null]
  message text [not null]
  type varchar [note: 'order | promo | system']
  event varchar(20) [note: 'placed | paid | confirmed | shipped | delivered | cancelled | welcome | promo | news | support']
  order_id int [ref: > orders.id]
  promo_code varchar(30)
  is_read boolean [default: false]
  created_at datetime
}

Table contact_messages {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  order_id int [ref: > orders.id, note: 'only for order and payment questions']
  topic varchar [not null, note: 'order | payment | product | other']
  message text [not null]
  status varchar [not null, default: 'open', note: 'open | answered']
  reply text
  replied_at datetime
  created_at datetime
}

Table reviews {
  id int [pk, increment]
  product_id int [not null, ref: > products.id]
  user_id int [not null, ref: > users.id]
  rating tinyint [not null, note: '1-5']
  comment text
  tags json [note: 'quality | as_pictured | packaging | delivery | value']
  created_at datetime
  updated_at datetime [note: 'set when edited']
  indexes { (user_id, product_id) [unique] }
}

Table coupons {
  id int [pk, increment]
  code varchar(30) [not null, unique, note: 'upper case, e.g. WELCOME10']
  description varchar(150) [not null]
  discount_type enum [not null, note: 'percent | fixed']
  value decimal(10,2) [not null]
  min_subtotal decimal(10,2) [not null, default: 0]
  max_discount decimal(10,2) [note: 'cap for percent coupons']
  expires_at datetime
  is_active bool [not null, default: true]
  created_at datetime
}
