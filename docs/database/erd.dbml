// Paste into https://dbdiagram.io to render the ERD

Table users {
  id int [pk, increment]
  full_name varchar(100) [not null]
  email varchar(150) [not null, unique]
  password_hash varchar(255) [not null]
  phone varchar(20)
  avatar_url varchar(255)
  role varchar [not null, default: 'customer', note: 'customer | admin']
  is_active boolean [not null, default: true]
  created_at datetime
  updated_at datetime
}

Table password_resets {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  code_hash varchar(255) [not null]
  expires_at datetime [not null]
  used boolean [default: false]
  created_at datetime
}

Table addresses {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  label varchar(50)
  recipient_name varchar(100) [not null]
  phone varchar(20) [not null]
  street varchar(255) [not null]
  city varchar(100) [not null]
  province varchar(100)
  postal_code varchar(20)
  is_default boolean [default: false]
  created_at datetime
}

Table categories {
  id int [pk, increment]
  name varchar(100) [not null]
  slug varchar(120) [not null, unique]
  description text
  image_url varchar(255)
  created_at datetime
}

Table series {
  id int [pk, increment]
  name varchar(100) [not null, note: 'Anime franchise, e.g. One Piece']
  slug varchar(120) [not null, unique]
  image_url varchar(255)
  created_at datetime
}

Table products {
  id int [pk, increment]
  category_id int [not null, ref: > categories.id]
  series_id int [ref: > series.id]
  brand varchar(100)
  name varchar(150) [not null]
  slug varchar(170) [not null, unique]
  description text
  price decimal(10,2) [not null]
  discount_price decimal(10,2)
  stock int [not null, default: 0]
  is_featured boolean [default: false]
  is_active boolean [default: true]
  created_at datetime
  updated_at datetime
}

Table product_images {
  id int [pk, increment]
  product_id int [not null, ref: > products.id]
  image_url varchar(255) [not null]
  is_primary boolean [default: false]
  sort_order int [default: 0]
}

Table cart_items {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  product_id int [not null, ref: > products.id]
  quantity int [not null, default: 1]
  created_at datetime
  indexes { (user_id, product_id) [unique] }
}

Table favorites {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  product_id int [not null, ref: > products.id]
  created_at datetime
  indexes { (user_id, product_id) [unique] }
}

Table orders {
  id int [pk, increment]
  order_number varchar(30) [not null, unique]
  user_id int [not null, ref: > users.id]
  shipping_name varchar(100) [not null]
  shipping_phone varchar(20) [not null]
  shipping_address varchar(500) [not null]
  subtotal decimal(10,2) [not null]
  shipping_fee decimal(10,2) [default: 0]
  total decimal(10,2) [not null]
  status varchar [note: 'pending | confirmed | shipped | delivered | cancelled']
  payment_method varchar [note: 'cod | khqr | card']
  payment_status varchar [note: 'unpaid | paid | failed | refunded']
  note varchar(255)
  created_at datetime
  updated_at datetime
}

Table order_items {
  id int [pk, increment]
  order_id int [not null, ref: > orders.id]
  product_id int [ref: > products.id]
  product_name varchar(150) [not null]
  unit_price decimal(10,2) [not null]
  quantity int [not null]
  subtotal decimal(10,2) [not null]
}

Table notifications {
  id int [pk, increment]
  user_id int [not null, ref: > users.id]
  title varchar(150) [not null]
  message text [not null]
  type varchar [note: 'order | promo | system']
  is_read boolean [default: false]
  created_at datetime
}

Table reviews {
  id int [pk, increment]
  product_id int [not null, ref: > products.id]
  user_id int [not null, ref: > users.id]
  rating tinyint [not null, note: '1-5']
  comment text
  created_at datetime
  indexes { (user_id, product_id) [unique] }
}
